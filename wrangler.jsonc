{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zafon-biz",
  "account_id": "d9749a22ca7fd24bea5979ce6137365b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "zafon-biz" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zafon-biz",
      "database_id": "07e92dbb-688a-4ec3-8afd-0663b21994c2",
      "migrations_dir": "migrations"
    }
  ],
  // Business photos (cover + logo). Served through the Worker at /media/<key>.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "zafon-biz-media" }
  ],
  "vars": {
    // Public base URL, used in password-reset links and the sitemap.
    "SITE_URL": "https://zafon-biz.sgolan20.workers.dev",
    // Address used as "from" in password-reset emails. Empty = email disabled
    // (the admin panel can still copy a reset link to send by WhatsApp).
    "EMAIL_FROM": ""
    // ADMIN_EMAIL (who gets an email for every new registration) is a secret:
    //   npx wrangler secret put ADMIN_EMAIL
  },
  "observability": { "enabled": true }
}
